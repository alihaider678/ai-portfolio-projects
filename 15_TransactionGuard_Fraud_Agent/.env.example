# Copy to `.env` and fill in. NEVER commit the real .env.

# Postgres + pgvector. Local (docker-compose): postgresql://tg:tg_local_dev@localhost:5434/transactionguard
# (port 5434, not 5433 — many dev machines already have a native Postgres on 5433)
# Deployed: your Supabase (or other Postgres+pgvector) connection string.
DATABASE_URL=postgresql://tg:tg_local_dev@localhost:5434/transactionguard

# Redis. Local (docker-compose): redis://localhost:6380/0
# Deployed: your Upstash (or other) Redis URL.
REDIS_URL=redis://localhost:6380/0

# BYOK is the default for real investigations — this key is ONLY used as a
# rate-limited fallback when a visitor clicks "Try demo" instead of pasting
# their own OpenAI key. Leave blank to disable demo mode entirely.
DEMO_OPENAI_API_KEY=

# Analyst ops-dashboard login, bootstrapped on first backend startup.
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=change-me

# JWT signing secret for the analyst session cookie — any long random string.
JWT_SECRET=dev-secret-change-me

# Cookie flags for the analyst session cookie.
# Local dev over plain http: COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Deployed (frontend + backend on different https domains): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated allowed frontend origin(s) for CORS.
FRONTEND_ORIGIN=http://localhost:3000
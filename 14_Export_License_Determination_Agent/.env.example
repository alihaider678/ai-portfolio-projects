# Copy to `.env` and fill in. NEVER commit the real .env.

# Required: used by the LLM product-classification node.
OPENAI_API_KEY=sk-...

# Optional: LangSmith observability. Create a free key at https://smith.langchain.com
# (Settings -> API Keys). Leave blank to run without tracing.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=licenseguard
# Copy to `.env` and fill in. NEVER commit the real .env.

# SQLite file path (default is fine for local dev and for Render — see README
# note on ephemeral disk: this resets on redeploy, which is fine since all data
# here is synthetic seed data + disposable session/demo-limit state).
DATABASE_PATH=./backend/walletassist.db

# BYOK is the default for real chat traffic — this key is ONLY used as a
# rate-limited fallback when a visitor clicks "Try demo" instead of pasting
# their own OpenAI key. Leave blank to disable demo mode entirely.
DEMO_OPENAI_API_KEY=

# Comma-separated allowed frontend origin(s) for CORS.
FRONTEND_ORIGIN=http://localhost:3000